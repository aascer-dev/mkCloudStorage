<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zjj.mkcsserver.mapper.FileFavoritesMapper">

    <select id="selectActiveFileIdsByUserId" resultType="java.lang.Long">
        SELECT file_id
        FROM file_favorites
        WHERE user_id = #{userId}
          AND status = 1
    </select>
</mapper>
