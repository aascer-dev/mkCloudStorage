{
  "enabled": true,
  "name": "调试 MKCS 服务器",
  "description": "以调试模式启动 MKCS 云存储服务器，调试端口 5005",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "请运行命令以调试模式启动 MKCS 服务器：mvn spring-boot:run -pl mkcs-server -Dspring-boot.run.jvmArguments=\"-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005 -Dspring.profiles.active=dev\""
  }
}