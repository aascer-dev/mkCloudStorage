# Local backend development against the external dev_env Compose project.
# Copy these keys into the repository-root .env and fill in the existing local passwords.
# Do not commit that filled .env file.
MKCS_DATASOURCE_HOST=127.0.0.1
MKCS_DATASOURCE_PORT=3306
MKCS_DATASOURCE_DATABASE=mkCloudStorage
MKCS_DATASOURCE_USERNAME=root
MKCS_DATASOURCE_PASSWORD=replace-with-your-dev-mysql-password

MKCS_REDIS_HOST=127.0.0.1
MKCS_REDIS_PORT=6379
MKCS_REDIS_DATABASE=10
MKCS_REDIS_PASSWORD=replace-with-your-dev-redis-password

MKCS_RABBITMQ_HOST=127.0.0.1
MKCS_RABBITMQ_PORT=5672
MKCS_RABBITMQ_USERNAME=admin
MKCS_RABBITMQ_PASSWORD=replace-with-your-dev-rabbitmq-password
MKCS_RABBITMQ_VIRTUAL_HOST=/

MKCS_MINIO_ACCESS_KEY=replace-with-your-dev-minio-access-key
MKCS_MINIO_SECRET_KEY=replace-with-your-dev-minio-secret-key
MKCS_MINIO_ENDPOINT=http://127.0.0.1:9000
MKCS_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MKCS_MINIO_BUCKET_NAME=sky-take-out
